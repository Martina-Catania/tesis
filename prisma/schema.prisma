// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Zone {
  CABA
  AMBA_1
  AMBA_2
  AMBA_3
}

// ─── Clients ────────────────────────────────────────────────────────────────

model Client {
  id   Int    @id @default(autoincrement())
  name String @unique

  aliases    Alias[]
  addresses  Address[]
  deliveries MeasurementData[]
  remitos    Remito[]
  matches    DeliveryMatch[]
}

model Alias {
  id    Int    @id @default(autoincrement())
  alias String @unique

  clientId Int    @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model Address {
  id      Int     @id @default(autoincrement())
  address String
  zone    Zone
  active  Boolean @default(true)

  clientId Int    @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  remitos Remito[]

  @@index([clientId])
}

// ─── Tariffs ─────────────────────────────────────────────────────────────────

// One row per tariff period (e.g. "Mayo 2026 (desde el 12/05)")
model TariffPeriod {
  id        Int      @id @default(autoincrement())
  label     String   @unique            // e.g. "Mayo 2026"
  validFrom DateTime @map("valid_from") // e.g. 2026-05-12

  rates       TariffRate[]       // volume-bracket rates per zone
  hourlyRates TariffHourlyRate[] // only for CABA
  deliveries  MeasurementData[]
}

/**
Volume-bracket rates per zone.
Each row = one bracket + zone combination within a period.
  Hasta 0.05 m3
  > 0.05 < 0.10 m3
  > 0.10 < 0.30 m3
  > 0.30 < 0.50 m3
  > 0.50 < 0.75 m3
  > 0.75 < 1.00 m3
  > 1.00 m3 (por m3)
 */
model TariffRate {
  id          Int     @id @default(autoincrement())
  volumeMinM3 Float   @map("volume_min_m3") // inclusive lower bound (0 for first bracket)
  volumeMaxM3 Float?  @map("volume_max_m3") // null means "no upper bound" (per-m3 rate)
  perM3       Boolean @default(false) @map("per_m3") // true for the "Más de 1m3, por m3" row
  zone        Zone
  price       Float

  periodId Int          @map("period_id")
  period   TariffPeriod @relation(fields: [periodId], references: [id])

  @@unique([periodId, volumeMinM3, volumeMaxM3, zone])
  @@index([periodId])
}

// Hourly rate — only exists for CABA in the Excel sheet
model TariffHourlyRate {
  id    Int   @id @default(autoincrement())
  zone  Zone  @default(CABA)
  price Float

  periodId Int          @map("period_id")
  period   TariffPeriod @relation(fields: [periodId], references: [id])

  @@unique([periodId, zone])
  @@index([periodId])
}

// ─── Measurement Data (Bultos) ────────────────────────────────────────────────

model MeasurementData {
  id   Int      @id @default(autoincrement())
  date DateTime @default(now())

  clientId Int    @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  // Which tariff period was active when this delivery was priced
  periodId Int?          @map("period_id")
  period   TariffPeriod? @relation(fields: [periodId], references: [id])

  packages Package[]
  match    DeliveryMatch?

  @@index([clientId])
  @@index([periodId])
  @@index([date])
}

model Package {
  id       Int   @id @default(autoincrement())
  length   Float
  width    Float
  height   Float
  quantity Int
  volume   Float

  measurementDataId Int             @map("measurement_data_id")
  measurementData   MeasurementData @relation(fields: [measurementDataId], references: [id])

  @@index([measurementDataId])
}

// ─── Measurement Data Errors ──────────────────────────────────────────────────

// Stores raw measurement data messages that failed to parse cleanly.
// Any subset of fields may be present depending on how far parsing got.
model MeasurementDataError {
  id   Int      @id @default(autoincrement())
  date DateTime @default(now())

  rawMessage String? @map("raw_message") // the original unparsed message

  // Client info extracted from the message, if any
  clientName String? @map("client_name") // raw name from message, if found
  clientId   Int?    @map("client_id")   // resolved FK if client was found in DB (no relation constraint intentionally)

  // Packages parsed before or around the error — stored as JSON since they are probably incomplete/unvalidated
  packages Json?

  // All error messages accumulated during parsing
  errors Json?

  @@index([clientId])
  @@index([date])
  @@map("MeasurementDataError")
}

// ─── Remitos ──────────────────────────────────────────────────────────────────

// A remito is a delivery receipt photo sent by a driver via WhatsApp image.
// Gemini Vision extracts the client name, delivery address, and package count.
// Remitos are stored separately from MeasurementData and
// are later matched and exported together as complete delivery records.
model Remito {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // Date the delivery took place — parsed from the remito or defaulting to today
  date DateTime

  // Raw text returned by Gemini Vision, kept for auditing / re-parsing
  rawText String @map("raw_text")

  // Extracted fields — null if Gemini could not identify them
  clientName String? @map("client_name") // as written on the remito
  address    String?
  packages   Int?    // package count circled on the remito

  // Resolved client FK — null until a human or automated job confirms the match
  clientId Int?    @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  // Resolved address FK — set when the extracted address matches a known client address
  addressId       Int?     @map("address_id")
  resolvedAddress Address? @relation(fields: [addressId], references: [id])

  // Whether a human has reviewed / confirmed the extracted data
  confirmed Boolean @default(false)

  match DeliveryMatch?

  @@index([clientId])
  @@index([addressId])
  @@index([date])
  @@index([confirmed])
}

// Stores remito images whose Gemini response could not be parsed or
// whose extracted data failed validation.
model RemitoError {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  date      DateTime

  // Raw Gemini response that triggered the error (may be empty/null if the API call itself failed)
  rawText String? @map("raw_text")

  // Whatever we managed to extract before hitting the error
  clientName String? @map("client_name")
  address    String?
  packages   Int?

  // All error messages accumulated during parsing
  errors Json

  @@index([date])
}

// ─── Delivery Matching ────────────────────────────────────────────────────────

// Tracks the last time the matching job ran successfully.
// There will only ever be one row (id = 1), updated in place.
model MatchRunLog {
  id        Int      @id @default(autoincrement())
  lastRunAt DateTime @map("last_run_at")

  @@map("match_run_log")
}

// A successful 1-to-1 pairing between a MeasurementData (bulto batch) and a
// Remito for the same client on the same calendar day.
// Both sides use unique relations — each record can only belong to one match.
model DeliveryMatch {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // The matched pair
  measurementDataId Int             @unique @map("measurement_data_id")
  measurementData   MeasurementData @relation(fields: [measurementDataId], references: [id])

  remitoId Int    @unique @map("remito_id")
  remito   Remito @relation(fields: [remitoId], references: [id])

  // Denormalised for quick reporting — copied from MeasurementData at match time
  clientId Int    @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  // The calendar day both records share (midnight UTC of delivery date)
  deliveryDate DateTime @map("delivery_date")

  // Package counts from each side (for audit trail)
  measuredPackages Int @map("measured_packages")
  remitoPackages   Int @map("remito_packages")

  @@index([clientId])
  @@index([deliveryDate])
  @@map("delivery_match")
}

// A failed or degraded match — created when:
//   a) one side has errors (MeasurementDataError xor RemitoError), or
//   b) both sides are valid but package counts differ, or
//   c) both sides are error records.
// Stores as much context as was available from both sides.
model DeliveryError {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // The calendar day of the attempted match
  deliveryDate DateTime @map("delivery_date")

  // Client context (at least one side must have a clientId for a match attempt)
  clientId   Int?    @map("client_id")
  clientName String? @map("client_name") // raw name from whichever side had it

  // Source record IDs — nullable because either side may be an error record
  measurementDataId      Int? @map("measurement_data_id")       // set if MeasurementData matched
  measurementDataErrorId Int? @map("measurement_data_error_id") // set if MeasurementDataError matched
  remitoId               Int? @map("remito_id")                 // set if Remito matched
  remitoErrorId          Int? @map("remito_error_id")           // set if RemitoError matched

  // Package counts from each side (null if that side had no package data)
  measuredPackages Int? @map("measured_packages")
  remitoPackages   Int? @map("remito_packages")

  // All errors accumulated (parse errors + mismatch errors from the matcher)
  errors Json

  @@index([deliveryDate])
  @@index([clientId])
  @@map("delivery_error")
}